{
  "name": "ai-novel-reader",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js --full",
    "dev:5175": "vite --host 0.0.0.0 --port 5175",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "build": "npm run typecheck && vite build && node scripts/inject-coi.cjs",
    "pack:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File pack-backend.ps1",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run probe:backup && npm run probe:maps && npm run probe:reupload && npm run probe:sync && npm run probe:rag && npm run probe:proxy && npm run probe:boot",
    "probe:backup": "node scripts/probe-backup-restore.mjs",
    "probe:maps": "node scripts/probe-maps-key.mjs",
    "probe:reupload": "node scripts/probe-novel-reupload.mjs",
    "probe:sync": "node scripts/probe-sync-session.mjs",
    "probe:rag": "node scripts/probe-rag-fingerprint.mjs",
    "probe:proxy": "node scripts/probe-proxy-stream.mjs",
    "probe:boot": "node scripts/probe-server-boot.mjs",
    "preview:migration": "node scripts/preview-db-migration.mjs",
    "audit:orphans": "node scripts/audit-joined-orphans.mjs",
    "audit:reach": "node scripts/audit-import-graph.mjs",
    "audit:discrimination": "node scripts/audit-discrimination.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts specs/a-smoke.spec.ts",
    "e2e:ab": "playwright test --config e2e/playwright.config.ts specs/a-smoke.spec.ts specs/b-import.spec.ts",
    "e2e:built": "playwright test --config e2e/playwright.config.ts --project=build",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:real": "playwright test --config e2e/playwright.real.config.ts",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.7",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "onnxruntime-node": "1.14.0",
    "onnxruntime-web": "1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "semver": "^7.7.3",
    "@xenova/transformers": {
      "onnxruntime-web": "$onnxruntime-web",
      "onnxruntime-node": "$onnxruntime-node"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
